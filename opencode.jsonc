// Siddique Tours and Travels — opencode project configuration.
// JSONC: comments and trailing commas are allowed.
// Full reference: https://opencode.ai/config.json
{
  "$schema": "https://opencode.ai/config.json",

  // Always inject project context and rules so the mandatory pre-implementation
  // protocol (load agents/skills before any code change) is in effect.
  "instructions": ["context.md", "AI_RULE.md"],

  // Register the specialized engineering skills from agents/skills.
  "skills": {
    "paths": ["agents/skills"]
  },

  // Convenience commands aligned with the repo's npm scripts.
  "command": {
    "lint": {
      "description": "Run ESLint verification",
      "template": "Run `npm run lint` and fix any errors or warnings this command reports."
    },
    "build": {
      "description": "Run production build",
      "template": "Run `npm run build` and fix any errors this command reports."
    },
    "dev": {
      "description": "Run development server",
      "template": "Run `npm run dev` to start the local development server."
    }
  },

  // Fail-open, AI-friendly permission defaults: keep secrets safe, allow git and npm.
  "permission": {
    "bash": {
      "npm *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "ls*": "allow",
      "dir*": "allow",
      "*": "allow"
    },
    "external_directory": {
      "*": "ask"
    }
  }
}